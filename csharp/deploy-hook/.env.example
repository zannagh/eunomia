# Copy to  ../.env  (next to docker-compose.yml, i.e. csharp/.env) and fill in.
# `.env` is gitignored; docker compose reads it automatically.

# --- REQUIRED ---

# Shared secret for the GitHub webhook HMAC. Generate one with:  openssl rand -hex 32
# Put the SAME value into the webhook's "Secret" field on GitHub
# (repo Settings -> Webhooks -> your hook). Without a matching secret every delivery is rejected.
WEBHOOK_SECRET=

# Absolute path on the HOST to the directory that holds docker-compose.yml (this stack's dir).
# It is bind-mounted into the receiver at the same path so `docker compose` inside the container
# resolves the stack's relative bind mounts (./dpkeys) to real host paths.
COMPOSE_DIR=/Volumes/Services/eunomia

# --- OPTIONAL ---

# GHCR login for pulling the image if the package is PRIVATE. Create a token with the
# `read:packages` scope (github.com/settings/tokens) and set it here. Leave GHCR_TOKEN empty if
# you make the package public.
GHCR_USER=zannagh
GHCR_TOKEN=

# Compose project name of the running stack (default: eunomia). Must match your containers'
# prefix, e.g. "eunomia" in eunomia-eunomia-1.
# COMPOSE_PROJECT_NAME=eunomia

# Host port the receiver listens on (default 9000). Point your public webhook URL at /ci/released
# on this port (usually via your existing reverse proxy).
# DEPLOY_HOOK_PORT=9000

# Name of the Bitwarden note to read app secrets from, IF the bw CLI + jq are available here with
# an unlocked vault (otherwise ignored). Default: zshenv.
# ENV_NOTE_ITEM=zshenv
