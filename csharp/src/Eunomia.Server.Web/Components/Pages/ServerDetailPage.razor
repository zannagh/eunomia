@page "/servers/{*Scope}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.StaffOnly)]
@inject IServerDirectory Directory
@inject IServerBlockService BlockService
@inject NavigationManager Navigation

<PageTitle>@ScopeLabel - Eunomia</PageTitle>

<div class="eu-page">
    <div class="eu-page-head">
        <div>
            <a href="/dashboard" class="eu-back">&larr; Servers</a>
            <h1>@ScopeLabel</h1>
            <div class="eu-muted eu-mono">@Scope</div>
        </div>
        <button class="eu-btn" @onclick="ReloadAsync" disabled="@_loading">Refresh</button>
    </div>

    @if (_detail is null)
    {
        <div class="eu-empty">@(_loading ? "Loading..." : "Unknown server.")</div>
    }
    else
    {
        <div class="eu-stat-row">
            <div class="eu-stat"><span class="eu-stat-value">@_detail.Summary.LiveUserCount</span><span class="eu-stat-label">Live users</span></div>
            <div class="eu-stat"><span class="eu-stat-value">@_detail.Summary.UpdateCount</span><span class="eu-stat-label">Updates</span></div>
            <div class="eu-stat"><span class="eu-stat-value">@_detail.TotalEntries</span><span class="eu-stat-label">Stored entries</span></div>
            <div class="eu-stat"><span class="eu-stat-value">@(_detail.Summary.Online ? "Online" : "Offline")</span><span class="eu-stat-label">Status</span></div>
        </div>

        <section class="eu-section">
            <h2>Moderation</h2>
            <AuthorizeView Policy="@AuthorizationPolicies.AdminOnly">
                <Authorized>
                    @if (_isBlocked)
                    {
                        <div class="eu-alert eu-alert-danger">
                            Blocked@(string.IsNullOrEmpty(_blockReason) ? string.Empty : $": {_blockReason}")
                        </div>
                        <button class="eu-btn eu-btn-primary" @onclick="UnblockAsync" disabled="@_busy">Unblock server</button>
                    }
                    else
                    {
                        <div class="eu-block-form">
                            <input class="eu-input" placeholder="Reason (optional)" @bind="_reasonInput" />
                            <button class="eu-btn eu-btn-danger" @onclick="BlockAsync" disabled="@_busy">Block server</button>
                        </div>
                    }
                </Authorized>
                <NotAuthorized>
                    @* Moderators keep read-only visibility of block status; only Admins can change it. *@
                    @if (_isBlocked)
                    {
                        <div class="eu-alert eu-alert-danger">
                            Blocked@(string.IsNullOrEmpty(_blockReason) ? string.Empty : $": {_blockReason}")
                        </div>
                    }
                    else
                    {
                        <div class="eu-muted">This server is not blocked.</div>
                    }
                    <div class="eu-muted">Blocking requires an administrator.</div>
                </NotAuthorized>
            </AuthorizeView>
        </section>

        <section class="eu-section">
            <h2>Channels</h2>
            @if (_detail.Channels.Count == 0)
            {
                <div class="eu-muted">No stored channels.</div>
            }
            else
            {
                <table class="eu-table">
                    <thead><tr><th>Channel</th><th class="eu-num">Entries</th></tr></thead>
                    <tbody>
                        @foreach (ChannelStat channel in _detail.Channels)
                        {
                            <tr><td class="eu-mono">@channel.Channel</td><td class="eu-num">@channel.EntryCount</td></tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="eu-section">
            <div class="eu-section-head">
                <h2>Logs</h2>
                <div class="eu-log-filters">
                    <select class="eu-input" @bind="_levelFilter">
                        <option value="">All levels</option>
                        <option value="Information">Information</option>
                        <option value="Warning">Warning</option>
                        <option value="Error">Error</option>
                        <option value="Fatal">Fatal</option>
                    </select>
                    <select class="eu-input" @bind="_logLimit">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="250">250</option>
                    </select>
                    <button class="eu-btn" @onclick="LoadLogsAsync" disabled="@_loading">Apply</button>
                </div>
            </div>
            @if (_logs.Count == 0)
            {
                <div class="eu-muted">No log entries.</div>
            }
            else
            {
                <div class="eu-logs">
                    @foreach (ServerLogRecord entry in _logs)
                    {
                        <div class="eu-log-line">
                            <span class="eu-log-time">@entry.Timestamp.ToString("MM-dd HH:mm:ss")</span>
                            <span class="eu-log-level eu-level-@entry.Level.ToLowerInvariant()">@entry.Level</span>
                            <span class="eu-log-msg">@entry.Message</span>
                            @if (!string.IsNullOrEmpty(entry.Exception))
                            {
                                <pre class="eu-log-ex">@entry.Exception</pre>
                            }
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter]
    public string? Scope { get; set; }

    private ServerDetail? _detail;
    private IReadOnlyList<ServerLogRecord> _logs = [];
    private string _levelFilter = string.Empty;
    private int _logLimit = 100;
    private string _reasonInput = string.Empty;
    private bool _isBlocked;
    private string? _blockReason;
    private bool _loading;
    private bool _busy;

    private string ScopeLabel => _detail?.Summary.Name is { Length: > 0 } name ? name : Scope ?? "Server";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(Scope))
        {
            return;
        }

        _loading = true;
        _detail = await Directory.GetAsync(Scope);
        _isBlocked = BlockService.IsBlocked(Scope);
        _blockReason = _detail?.Summary.BlockReason;
        await LoadLogsAsync();
        _loading = false;
    }

    private async Task LoadLogsAsync()
    {
        if (string.IsNullOrEmpty(Scope))
        {
            return;
        }

        _logs = await Directory.GetLogsAsync(Scope, string.IsNullOrEmpty(_levelFilter) ? null : _levelFilter, _logLimit);
    }

    private async Task BlockAsync()
    {
        if (string.IsNullOrEmpty(Scope))
        {
            return;
        }

        _busy = true;
        await BlockService.BlockAsync(Scope, string.IsNullOrWhiteSpace(_reasonInput) ? null : _reasonInput);
        _reasonInput = string.Empty;
        await ReloadAsync();
        _busy = false;
    }

    private async Task UnblockAsync()
    {
        if (string.IsNullOrEmpty(Scope))
        {
            return;
        }

        _busy = true;
        await BlockService.UnblockAsync(Scope);
        await ReloadAsync();
        _busy = false;
    }
}
