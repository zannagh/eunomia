@page "/oauth-select"
@layout EmptyLayout
@inject EunomiaAuthSettings Settings

@* Static SSR by design: no @rendermode, so login works the instant the HTML lands and never
   depends on the SignalR circuit. Each provider is a plain GET link to the account controller,
   which 302s to the provider, so a click always leaves this page cleanly. *@

<PageTitle>Sign in - Eunomia</PageTitle>

<div class="eu-login">
    <div class="eu-login-card">
        <div class="eu-login-head">
            <span class="eu-brand-mark eu-brand-mark-lg"></span>
            <h1>Eunomia</h1>
            <p>Server administration &amp; telemetry</p>
        </div>

        @if (Error is not null)
        {
            <div class="eu-alert eu-alert-danger" role="alert">Sign-in didn't complete. Please try again.</div>
        }

        <div class="eu-providers">
            @if (Settings.GitHubOAuth.Enabled)
            {
                <a href="/account/external?provider=github" class="eu-provider" rel="nofollow">Sign in with GitHub</a>
            }
            @if (Settings.GoogleOAuth.Enabled)
            {
                <a href="/account/external?provider=google" class="eu-provider" rel="nofollow">Sign in with Google</a>
            }
            @if (Settings.MicrosoftOAuth.Enabled)
            {
                <a href="/account/external?provider=microsoft" class="eu-provider" rel="nofollow">Sign in with Microsoft</a>
            }
            @if (Settings.ModrinthOAuth.Enabled)
            {
                <a href="/account/external?provider=modrinth" class="eu-provider" rel="nofollow">Sign in with Modrinth</a>
            }
            @if (!AnyProviderEnabled)
            {
                <div class="eu-alert eu-alert-info" role="alert">
                    No sign-in providers are configured. Set a provider's <code>Enabled</code> flag, or use the
                    <code>EUNOMIA_DEV_USER</code> dev bypass in Development.
                </div>
            }
        </div>

        <p class="eu-login-foot">Secured with OAuth 2.0</p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool AnyProviderEnabled =>
        Settings.GitHubOAuth.Enabled
        || Settings.GoogleOAuth.Enabled
        || Settings.MicrosoftOAuth.Enabled
        || Settings.ModrinthOAuth.Enabled;
}
